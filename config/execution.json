{
  "execution": {
    "mode": "api_only",
    "description": "api_only = 100% API (DEFAULT 2026: Playwright is opt-in, ToS risk + 16x cost). hybrid = 85% API + 15% Playwright. playwright_only = 100% Playwright.",
    "modes": ["hybrid", "api_only", "playwright_only"],
    "playwright_sample_rate": 0.15,
    "prompt_count": 50,
    "max_concurrent_api": 10,
    "max_concurrent_playwright": 3,
    "request_timeout_ms": 120000,
    "temperature": 0.15,
    "top_p": 0.9,
    "max_tokens": 4096,
    "search_options": {
      "tool_choice": "auto",
      "allowed_domains": [],
      "search_context_size": "medium",
      "return_sources": "full_list"
    },
    "volatility": {
      "enabled": true,
      "description": "Repeat money prompts N times; AIO shifts ~70% on repeat. Single-run SoMV is theater.",
      "repeats": 5,
      "money_turn_types": ["comparison_analysis", "pricing_procurement"]
    },
    "geo": {
      "default_country": "us",
      "countries": ["us"],
      "description": "Replicate money prompts per country for multi-country tracking (Peec Advanced pattern)."
    },
    "scheduler": {
      "enabled": false,
      "cron": "0 6 * * *",
      "description": "Daily 06:00 tracking. Enable via scheduler/runner or cron calling npm run full-run.",
      "alerts": {
        "somv_drop_pct": 15,
        "hallucination_spike": true,
        "new_negative_triple": true,
        "webhook_env": "SLACK_WEBHOOK_URL"
      }
    },
    "serp": {
      "provider": "serper",
      "description": "SERP API for Google AI Overviews / AI Mode / Copilot (DataForSEO | serper | zenserp). Set SERP_API_KEY + SERP_PROVIDER.",
      "geo": "us"
    },
    "retry": {
      "attempts": 3,
      "delay_ms": 2000,
      "backoff_multiplier": 2.0,
      "max_delay_ms": 30000
    },
    "rate_limiting": {
      "openai": { "rpm": 500, "tpm": 200000 },
      "anthropic": { "rpm": 1000, "tpm": 100000 },
      "google": { "rpm": 60, "tpm": 32000 },
      "perplexity": { "rpm": 200, "tpm": 200000 },
      "deepseek": { "rpm": 1000, "tpm": 100000 },
      "xai": { "rpm": 200, "tpm": 200000 }
    },
    "cost_tracking": {
      "enabled": true,
      "daily_budget_usd": 500.0,
      "alert_threshold_pct": 80,
      "track_per_model": true,
      "track_per_persona": true
    },
    "verification": {
      "enabled": true,
      "description": "Quality gates, credibility scoring, and live citation URL verification for every response",
      "citation_http_check": true,
      "citation_concurrency": 8,
      "citation_timeout_ms": 15000,
      "reject_failed_quality": false,
      "require_verified_citations": false
    },
    "session_management": {
      "persist_cookies": true,
      "session_dir": "./data/sessions",
      "max_session_age_hours": 24
    },
    "playwright": {
      "headless": true,
      "stealth_mode": true,
      "warning": "Playwright web-UI collection is OPT-IN: stealth + residential proxy required, account ToS risk. API vs UI diverge — use only as 20% parity control group.",
      "proxy": {
        "enabled": false,
        "server": "",
        "username": "",
        "password": ""
      },
      "browser_args": [
        "--disable-blink-features=AutomationControlled",
        "--no-sandbox",
        "--disable-setuid-sandbox",
        "--disable-dev-shm-usage"
      ],
      "viewport": { "width": 1920, "height": 1080 },
      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
    }
  },
  "multi_turn": {
    "enabled": true,
    "min_turns": 3,
    "max_turns": 5,
    "turn_types": [
      "category_discovery",
      "feature_deep_dive",
      "comparison_analysis",
      "objection_compliance",
      "pricing_procurement"
    ],
    "citation_decay_tracking": true,
    "session_state_persistence": true
  },
  "attribution_split": {
    "enabled": true,
    "description": "Run each prompt twice: once with RAG/web search ON, once OFF to measure pre-training vs retrieval attribution. Grounded-only toggle filters memory-vs-memory comparisons.",
    "rag_enabled_model_override": {
      "openai": "gpt-5-5",
      "perplexity": "sonar-pro"
    },
    "rag_disabled_fallback": {
      "openai": "gpt-5-5",
      "anthropic": "claude-4-sonnet",
      "google": "gemini-2-5-pro",
      "deepseek": "deepseek-v3"
    }
  }
}
