# Node.js Environment Variables for AEO Citation Graph Simulator
# Copy this to .env and fill in your API keys

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=org-your-org-id

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google AI Studio (Gemini 1.5 Pro, Gemini 2.0 Flash)
GOOGLE_AI_API_KEY=your-google-ai-key

# Perplexity (Sonar Pro, Sonar Online)
PERPLEXITY_API_KEY=pplx-your-perplexity-key

# DeepSeek (DeepSeek-V2, DeepSeek Coder)
DEEPSEEK_API_KEY=your-deepseek-key

# Playwright Configuration
HEADLESS=true
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
RESIDENTIAL_PROXY旋转=

# Execution Parameters
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_MS=120000
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000

# Model Parameters
TEMPERATURE=0.15
TOP_P=0.9
MAX_TOKENS=4096

# RAG Toggle (for dual-query attribution split)
RAG_ENABLED=true
RAG_DISABLED=false

# Output Paths
OUTPUT_DIR=./data/output
GRAPHS_DIR=./data/output/graphs
REPORTS_DIR=./data/output/reports
EMBEDDINGS_DIR=./data/output/embeddings
PROMPTS_DIR=./data/prompts

# Python Bridge
PYTHON_ENGINE_PATH=./src/python-engine
PYTHON_EXECUTABLE=python3

# Cost Tracking
DAILY_BUDGET_USD=500.00
COST_ALERT_THRESHOLD=0.8

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
