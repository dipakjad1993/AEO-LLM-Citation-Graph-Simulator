# AEO Citation Graph Simulator — environment template (2026-09)
# Copy to .env and fill in. Lite install: pip install -r requirements-lite.txt

# --- LLM providers (at least one for real runs; none needed for demo) ---
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_AI_API_KEY=your-google-ai-key
PERPLEXITY_API_KEY=pplx-your-perplexity-key
DEEPSEEK_API_KEY=your-deepseek-key
XAI_API_KEY=your-xai-key

# --- SERP API for AI Overviews / AI Mode / Copilot (serper | dataforseo | zenserp) ---
SERP_API_KEY=
SERP_PROVIDER=serper
DATAFORSEO_LOGIN=
SERP_GEO=us

# --- Server security ---
# Set to require a token on all /api/* routes (send Authorization: Bearer <token>).
AEO_AUTH_TOKEN=
PORT=3000
# CORS allow-list (comma-separated). '*' is DEV-ONLY and logs a boot warning; set explicit origins in prod.
AEO_CORS_ORIGIN=
# Request correlation / observability (OTLP-compatible JSONL to logs/otel.jsonl)
OTEL_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Enterprise SSO/RBAC (OIDC). Unset = single-token mode (dev/SMB, logged). Set all three for JWT enforcement.
AEO_OIDC_ISSUER=
AEO_OIDC_AUDIENCE=
AEO_OIDC_JWKS_URL=

# --- Demo (keyless): AEO_DEMO_MODE=1 or `npm run demo` ---
AEO_DEMO_MODE=

# --- Scheduler alerts ---
SLACK_WEBHOOK_URL=

# --- Heavy ML opt-ins (default OFF; lite deps suffice) ---
AEO_SPACY_HEAVY=
AEO_SENTIMENT_HEAVY=

# Playwright (PARITY CONTROL ONLY: <=15% sample, ToS risk — see docs/providers.md)
# Automating provider web UIs may violate ToS; default mode is api_only. Never primary collection.
HEADLESS=true
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Execution
MAX_CONCURRENT_REQUESTS=10
TEMPERATURE=0.15
TOP_P=0.9
MAX_TOKENS=4096
LOG_LEVEL=info
DAILY_BUDGET_USD=500.00
